SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
GEMINI_API_KEY=

# Required on Vercel. Use a Supabase PostgreSQL connection string with SSL enabled.
DATABASE_URL=

# Required on Vercel for persistent resume/profile uploads. Create a private
# Supabase Storage bucket and generate S3 credentials.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_REGION=us-east-1

# Set this for custom production domains. Vercel deployment domains are detected automatically.
CSRF_TRUSTED_ORIGINS=
